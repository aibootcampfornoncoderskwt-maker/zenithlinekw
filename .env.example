# Copy this file to .env and fill in real values as they become available.
# All variables here are PUBLIC_-prefixed by Astro convention, meaning they are
# exposed to the browser build — do not put secrets in this file or in .env.
# Every variable is optional: if a value is absent, the corresponding tag/script
# is not rendered at all (no blank meta tags, no analytics loaded).

# Google Search Console HTML-tag verification (Settings > Ownership verification > HTML tag).
# Paste only the "content" value from the meta tag Google gives you, not the whole tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools HTML-tag verification (equivalent to the above, from Bing Webmaster Tools).
PUBLIC_BING_SITE_VERIFICATION=

# GA4 Measurement ID (format: G-XXXXXXXXXX) from Google Analytics > Admin > Data Streams.
# Leave empty until analytics/consent requirements have been reviewed with the client.
PUBLIC_GA_MEASUREMENT_ID=
