---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { productGroups, site } from '../data/site';
---

<BaseLayout title="Technical Products, Materials & Supply in Kuwait" description="Zenith Line supplies network components, fibre and copper products, CCTV, UPS, tools, computers, construction materials and selected agricultural products." image="/images/network-rack.webp">
  <PageHero eyebrow="PRODUCTS & SUPPLY" title="Technical Products and Project Materials" text="A broad sourcing and supply capability across telecom, IT, power, tools, office equipment, construction, industrial and selected agricultural categories." image="/images/network-rack.webp" imageAlt="Network components and structured cabling rack" crumbs={[{ label: 'Home', href: '/' }, { label: 'Products & Supply' }]} />
  <section class="section"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">SUPPLY CATEGORIES</span><h2>One Route for Multiple Project Requirements</h2></div><p>Specific brands, specifications, availability, warranty, payment and delivery terms are confirmed against each enquiry and quotation.</p></div><div class="product-grid">{productGroups.map((group, index) => <article class="product-card reveal"><span>{String(index + 1).padStart(2, '0')}</span><h2>{group.title}</h2><p>{group.text}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container content-grid"><article class="content-card reveal" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.12)"><span class="eyebrow">NETWORK & TELECOM</span><h2 style="color:white;font-size:2rem">Compatible Global Brands</h2><p>Equipment and components can be sourced according to the required specification and compatibility. Brands referenced in the company profile include Cisco, Juniper, Nokia, Alcatel-Lucent, Huawei, CommScope, Corning, Fujikura, Hikvision, Dahua, Honeywell, Aruba, APC and others.</p></article><article class="content-card reveal" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.12)"><span class="eyebrow">IMPORTANT</span><h2 style="color:white;font-size:2rem">Availability by Quotation</h2><p>Brand names describe sourcing capability and compatibility requirements. They do not imply exclusive distributorship or partnership unless separately documented by Zenith Line.</p></article></div></section>
  <section class="section section-ivory"><div class="container enquiry-layout"><div class="reveal"><span class="eyebrow">REQUEST A QUOTATION</span><h2>Send the Specification or Bill of Quantity</h2><p style="margin-top:20px">Include the product, brand preference, model, quantity, Kuwait delivery location and required date. WhatsApp will open with the details ready to send.</p><a class="text-link" href={`mailto:${site.email}`}>Or email {site.email} <span>→</span></a></div><div class="reveal"><EnquiryForm defaultService="Supply & Logistics" compact sourceUrl={`${site.domain}/products-supply/`} /></div></div></section>
</BaseLayout>
