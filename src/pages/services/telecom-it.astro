---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';

const telecomServices = services.filter((service) => service.category === 'Telecom & IT');

const title = 'Telecom & IT Services in Kuwait | Zenith Line';
const description = 'Integrated telecom and IT services in Kuwait for wired and wireless networks, cabling, CCTV, access control, voice, public address, Wi-Fi and support.';
const canonical = `${site.domain}/services/telecom-it/`;
const message = `Hello Zenith Line, I would like to discuss a Telecom & IT requirement in Kuwait.\n\nRequired service:\nKuwait area:\nProperty/facility:\nRequirement:\nSource page: ${canonical}`;
const whatsappUrl = `https://wa.me/${site.phoneRaw}?text=${encodeURIComponent(message)}`;
const faqs = [
  { question: 'What Telecom & IT services does Zenith Line provide in Kuwait?', answer: 'Zenith Line handles project-based wired and wireless networks, structured cabling, CCTV, PBX and IP telephony, door access, public address, business Wi-Fi, network security and IT technical support. Every quotation defines the included products, installation, configuration, testing and handover.' },
  { question: 'Can several Telecom & IT systems be delivered under one project?', answer: 'Yes. Connected systems can be coordinated when their interfaces, responsibilities, programme and acceptance requirements are clearly defined. One scope might align cabling, Wi-Fi, CCTV, access control and voice without treating them as the same technical discipline.' },
  { question: 'Does Zenith Line work across Kuwait?', answer: 'Enquiries are accepted for sites across Kuwait. Scheduling, access, survey needs and delivery arrangements depend on the location and approved project scope.' },
  { question: 'Can Zenith Line survey an existing system before recommending replacement?', answer: 'Yes. Drawings, photographs, equipment models, symptoms and site access can be reviewed to identify what may remain, what limits the system and which further tests are appropriate.' },
  { question: 'Are the brands shown on the website authorized partnerships?', answer: 'No authorization or distributorship is implied. Brand references show product categories that may be relevant to a requirement, subject to availability, compatibility and the approved quotation.' },
  { question: 'What should I send for a useful first enquiry?', answer: 'Send the Kuwait area, property or facility type, required service, drawings or photographs, current equipment, quantities if known, symptoms or desired outcome, preferred brands, project timing and any testing or documentation requirement.' },
  { question: 'Are permits, 24/7 support or guaranteed response times included?', answer: 'They are not automatically included. Regulatory duties, permits, service hours, response targets and SLA terms must be confirmed for the specific project and stated in writing.' }
];
const related = services.filter((item) => ['supply-logistics', 'engineering-manpower', 'civil-road-works'].includes(item.slug));
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonical}#webpage`, name: 'Telecom & IT Services in Kuwait', description, url: canonical, inLanguage: 'en', areaServed: { '@type': 'Country', name: 'Kuwait' }, isPartOf: { '@id': `${site.domain}/#website` }, about: { '@id': `${site.domain}/#organization` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` }, { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.domain}/services/` }, { '@type': 'ListItem', position: 3, name: 'Telecom & IT', item: canonical }] },
  { '@context': 'https://schema.org', '@type': 'ItemList', '@id': `${canonical}#services`, numberOfItems: telecomServices.length, itemListElement: telecomServices.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.shortTitle, url: `${site.domain}/services/${item.slug}/` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }
];
---

<BaseLayout title={title} description={description} image={telecomServices[0].image} schema={schema}>
  <PageHero eyebrow="INTEGRATED CONNECTED INFRASTRUCTURE" title="Telecom & IT Services in Kuwait" text="Zenith Line plans and delivers defined telecom, networking, physical-security, voice and IT infrastructure scopes for commercial, residential and operational facilities across Kuwait." image={telecomServices[0].image} imageAlt={telecomServices[0].imageAlt} imageWidth={1200} imageHeight={800} crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: 'Telecom & IT' }]} primaryAction={{ label: 'Discuss a Telecom & IT Requirement', href: whatsappUrl }} secondaryAction={{ label: 'Explore All 10 Services', href: '#telecom-services' }} reassurance="Survey-led scope • Compatible systems • Clear project handover" serviceName="Telecom & IT" />

  <section class="service-glance" aria-labelledby="hub-answer"><div class="container service-glance-grid"><div><span class="eyebrow">DIRECT ANSWER</span><h2 id="hub-answer">One enquiry path for connected business infrastructure</h2></div><p class="service-lead">Zenith Line brings together fibre and copper routes, structured cabling, wireless links, Wi-Fi, CCTV, access control, PBX, paging, network security and technical support. Each discipline keeps its own design and acceptance criteria while interfaces are coordinated around the building and approved project scope.</p></div></section>

  <section class="section" id="telecom-services" aria-labelledby="services-heading"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">TEN TELECOM & IT CAPABILITIES</span><h2 id="services-heading">Choose the service that matches your requirement</h2></div><p>Each page explains likely scope, selection factors, process, evidence limits and the details to send for a useful Kuwait quotation.</p></div><div class="services-grid hub-services-grid">{telecomServices.map((item, index) => <ServiceCard service={item} index={index} />)}</div></div></section>

  <section class="section section-dark" aria-labelledby="infrastructure-heading"><div class="container hub-capability-grid"><article class="reveal"><span class="eyebrow">WIRED INFRASTRUCTURE</span><h2 id="infrastructure-heading">Routes, backbones and structured cabling</h2><p>Wired network work addresses indoor or outdoor fibre and copper routes, civil interfaces, pulling, termination and testing. Structured cabling organizes building endpoints, racks, patch panels, outlets and fibre backbones under a defined standards and documentation basis.</p><a class="text-link light" href="/services/wired-network/">Explore wired network solutions →</a></article><article class="reveal"><span class="eyebrow">WIRELESS CONNECTIVITY</span><h2>Indoor coverage and links between sites</h2><p>Business Wi-Fi connects users within a property through routers and access points. Point-to-point or microwave equipment bridges buildings or sites and requires separate line-of-sight, mounting, capacity and regulatory review.</p><a class="text-link light" href="/services/wireless-microwave-networks/">Explore wireless and microwave networks →</a></article></div></section>

  <section class="section section-ivory" aria-labelledby="security-heading"><div class="container hub-capability-grid"><article class="reveal"><span class="eyebrow">SECURITY, SURVEILLANCE & ACCESS</span><h2 id="security-heading">Purposeful coverage and controlled entry</h2><p>CCTV planning aligns required views, cameras, recording, storage and IP infrastructure. Door access control aligns readers, locks, controllers, credentials and event reporting. Network security remains a separate digital discipline for firewall, VLAN, VPN and access policies.</p><a class="text-link" href="/services/cctv-surveillance-systems/">Review CCTV surveillance systems →</a></article><article class="reveal"><span class="eyebrow">VOICE & PUBLIC ADDRESS</span><h2>Business calls, paging and zone audio</h2><p>PBX and IP telephone work covers extensions, IVR, routing, gateways and controlled migration. Public address work covers routine paging, announcements, background audio, zones, speakers and amplification without unsupported life-safety certification claims.</p><a class="text-link" href="/services/pbx-telephone-exchange/">Review PBX and IP telephone solutions →</a></article></div></section>

  <section class="section" aria-labelledby="support-heading"><div class="container service-intro-grid"><div class="service-editorial reveal"><span class="eyebrow">IT SERVICES & SUPPORT</span><h2 id="support-heading">Installation, troubleshooting, upgrades and handover</h2><p class="service-lead">Project-based IT support can cover equipment installation, configuration, rack organization, moves, maintenance and fault triage. The work order defines access, timing, permitted changes and deliverables; no 24/7 coverage or guaranteed SLA is assumed.</p><div class="service-outcome"><strong>Connected outcome</strong><p>Infrastructure, systems and support responsibilities are documented so future changes start from reliable information.</p></div></div><aside class="service-cta-card reveal"><span class="eyebrow">START WITH THE RIGHT DETAILS</span><h2>What to send for an enquiry</h2><ul class="hub-checklist"><li>Required service and Kuwait area</li><li>Property or facility type</li><li>Plans, route drawings or clear photographs</li><li>Current equipment, models and symptoms</li><li>Quantities, users, distances or coverage areas</li><li>Preferred brands, timing and testing needs</li></ul><a class="button service-card-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-cta-location="hub-checklist" data-service="Telecom & IT" data-conversion="whatsapp">Send a Telecom & IT Enquiry ↗</a></aside></div></section>

  <section class="section section-ivory" aria-labelledby="delivery-heading"><div class="container"><div class="section-head centered reveal"><span class="eyebrow">DELIVERY PROCESS</span><h2 id="delivery-heading">From requirement to verified handover</h2></div><ol class="process-grid"><li class="process-step reveal"><h3>Share the requirement</h3><p>Identify the service, site, outcome, current systems and available drawings.</p></li><li class="process-step reveal"><h3>Survey and define interfaces</h3><p>Review routes, equipment, access, power, network, civil and regulatory dependencies.</p></li><li class="process-step reveal"><h3>Approve scope and execute</h3><p>Confirm products, quantities, exclusions, programme, testing and documentation before work.</p></li><li class="process-step reveal"><h3>Test and hand over</h3><p>Complete agreed functional checks and provide the included records or user guidance.</p></li></ol></div></section>

  <section class="section" aria-labelledby="faq-heading"><div class="container"><div class="section-head centered reveal"><span class="eyebrow">COMMON QUESTIONS</span><h2 id="faq-heading">Planning an integrated Telecom & IT requirement</h2></div><div class="faq-list reveal">{faqs.map((item, index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>

  <section class="section section-ivory" id="service-enquiry" aria-labelledby="enquiry-heading"><div class="container enquiry-layout"><div class="reveal"><span class="eyebrow">WHATSAPP ENQUIRY</span><h2 id="enquiry-heading">Discuss a Telecom & IT requirement in Kuwait</h2><p class="service-lead">Use the form or send the prepared WhatsApp message with your service, area, property and requirement. You can review the message before sending it.</p><a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-cta-location="hub-final" data-service="Telecom & IT" data-conversion="whatsapp">Open Prepared WhatsApp Enquiry ↗</a></div><div class="reveal"><EnquiryForm messageIntro="Hello Zenith Line, I would like to discuss a Telecom & IT requirement in Kuwait." sourceUrl={canonical} qualificationFields compact /></div></div></section>

  <section class="section" aria-labelledby="related-heading"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">RELATED CAPABILITIES</span><h2 id="related-heading">Project support beyond Telecom & IT</h2></div><a class="text-link" href="/services/">Explore all 20 services →</a></div><div class="services-grid services-grid-related">{related.map((item, index) => <ServiceCard service={item} index={index} />)}</div></div></section>
</BaseLayout>
