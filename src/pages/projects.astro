---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { projects, contact } from '../data/site';
---

<BaseLayout title="Construction, Infrastructure & Technology Projects Kuwait" description="View representative Zenith Line project experience across K-Span structures, construction, roads, flooring, shade structures, structured cabling and specialized works in Kuwait." image="/images/industrial-construction.webp">
  <PageHero eyebrow="PROJECT PORTFOLIO" title="Work Across Structures, Infrastructure & Technology" text="Representative photographs and capability examples drawn from the Zenith Line company portfolio. Detailed client identities, project values and completion claims remain subject to client approval." image="/images/industrial-construction.webp" imageAlt="Large industrial construction and flooring project" crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }]} />
  <section class="section"><div class="container"><div class="projects-grid">{projects.map((project) => <article class="project-card reveal"><img src={project.image} alt={project.title} width="900" height="600" loading="lazy" /><div class="project-card-content"><small>{project.category}</small><h2 style="font-size:1.55rem">{project.title}</h2><p>{project.text}</p></div></article>)}</div></div></section>
  <section class="section section-ivory"><div class="container service-intro-grid"><div class="reveal"><span class="eyebrow">HISTORICAL EXPERIENCE</span><h2>A Broad Schedule of Completed Works</h2><p class="service-lead" style="margin-top:22px">The company profile presents a historical work schedule covering shade structures, maintenance, building construction, roads, earthworks, flooring, waterproofing, fit-out and public-sector requirements.</p><p>Before individual contracts are published as website case studies, Zenith Line should confirm whether each entry represents direct company work, affiliated-company experience or combined team experience.</p></div><div class="service-outcome reveal"><strong>Need the complete schedule?</strong><p>Download the supplied 2025 profile to review the full Arabic previous-works tables.</p><a class="button" style="margin-top:18px" href="/downloads/zenith-line-company-profile-2025.pdf" download>Download Company Profile</a></div></div></section>
  <section class="cta-band"><div class="container cta-grid"><div><h2>Planning a Similar Project?</h2><p>Share your drawings, project location or initial requirement through WhatsApp.</p></div><div class="cta-actions"><a class="button" href={`${contact.whatsapp.href}?text=${encodeURIComponent('Hello Zenith Line, I would like to discuss a project similar to work shown in your portfolio.')}`} target="_blank" rel="noopener noreferrer" aria-label={`Enquire with Zenith Line on WhatsApp at ${contact.whatsapp.display}`} data-cta-location="projects" data-conversion="whatsapp">Discuss on WhatsApp ↗</a><a class="button button-outline-light" href="/contact/#enquiry">Send Project Details</a></div></div></section>
</BaseLayout>
