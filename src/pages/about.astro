---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout title="About Zenith Line Co. Kuwait" description="Learn about Zenith Line, its mission, vision and multi-disciplinary construction, engineering, infrastructure, telecom, IT and trading capabilities in Kuwait." image="/images/engineering-team.webp">
  <PageHero eyebrow="ABOUT ZENITH LINE" title="A Multi-Disciplinary Kuwait Project Partner" text="Established in Kuwait, Zenith Line brings civil, mechanical, electrical, structural, telecom, IT, trading and technical-support capabilities together for public and private-sector requirements." image="/images/engineering-team.webp" imageAlt="Engineering team coordinating a project" crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
  <section class="section"><div class="container service-intro-grid"><div class="reveal"><span class="eyebrow">OUR COMPANY</span><h2>Building Capability Around the Client’s Requirement</h2><p class="service-lead" style="margin-top:24px">Zenith Line is a private company in Kuwait specializing in civil, mechanical and electrical contracting alongside structural, infrastructure, telecom, IT, import/export and technical-supply services.</p><p>Our operating model brings together project management, engineering support, skilled teams, equipment sourcing and site execution. This enables us to address requirements ranging from K-Span structures and road works to HVAC, network infrastructure and specialist civil treatments.</p></div><div class="service-outcome reveal"><strong>Our commitment</strong><p>To deliver dependable project solutions with attention to quality, safety, timely coordination and long-term client relationships.</p></div></div></section>
  <section class="section section-dark"><div class="container content-grid"><article class="content-card reveal" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.12)"><span class="eyebrow">OUR VISION</span><h2 style="color:white;font-size:2.2rem">Industry Leadership</h2><p>To be a leading provider of innovative and sustainable construction, engineering and infrastructure solutions in Kuwait and beyond, recognized for quality and reliable partnerships.</p></article><article class="content-card reveal" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.12)"><span class="eyebrow">OUR MISSION</span><h2 style="color:white;font-size:2.2rem">Superior Project Value</h2><p>To provide high-quality services, adopt practical technologies, deliver agreed work on time and build enduring relationships through trust and responsible execution.</p></article></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">OUR GOALS</span><h2>Focused on Sustainable, Efficient Growth</h2></div><p>Our goals connect customer satisfaction with operational discipline, market development and environmentally responsible choices.</p></div><div class="content-grid"><article class="content-card reveal"><h3>Customer Satisfaction</h3><p>Understand client needs and deliver reliable, appropriate and cost-conscious solutions.</p></article><article class="content-card reveal"><h3>Market Presence</h3><p>Strengthen our Kuwait position through diverse capability and long-term partnerships.</p></article><article class="content-card reveal"><h3>Sustainability</h3><p>Consider environmentally responsible materials, methods and operating practices where applicable.</p></article><article class="content-card reveal"><h3>Operational Efficiency</h3><p>Coordinate resources, technology, safety and quality systems for productive project delivery.</p></article></div></div></section>
  <section class="section"><div class="container profile-banner reveal"><div><span class="eyebrow">COMPANY PROFILE</span><h2>Explore the Full Corporate Profile</h2><p>Review the detailed company introduction, service range, portfolio, organization references and historical project schedule supplied by Zenith Line.</p><a class="button" href="/downloads/zenith-line-company-profile-2025.pdf" download>Download Profile PDF ↗</a></div><div class="profile-brand-panel"><div class="profile-brand-pattern" aria-hidden="true"></div><span class="profile-brand-ring profile-brand-ring-one" aria-hidden="true"></span><span class="profile-brand-ring profile-brand-ring-two" aria-hidden="true"></span><div class="profile-brand-lockup"><img src="/images/zenith-logo.png" alt="Zenith Line Co. logo" width="320" height="302" loading="lazy" decoding="async" /><strong>ZENITH LINE <b>CO.</b></strong><small>CONTRACTING · TECHNOLOGY · SUPPLY</small></div></div></div></section>
  <section class="cta-band"><div class="container cta-grid"><div><h2>Have a Project Requirement in Kuwait?</h2><p>Contact our team to discuss the discipline, property, location and expected scope.</p></div><div class="cta-actions"><a class="button" href="/contact/#enquiry">Request a Consultation</a><a class="button button-outline-light" href={`https://wa.me/${site.phoneRaw}?text=${encodeURIComponent('Hello Zenith Line, I would like to discuss a project requirement in Kuwait.')}`}>WhatsApp Us</a></div></div></section>
</BaseLayout>
