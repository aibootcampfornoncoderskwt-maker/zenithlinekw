---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import InstagramIcon from '../components/InstagramIcon.astro';
import { site, contact } from '../data/site';
---

<BaseLayout title="Contact Zenith Line Kuwait" description="Contact Zenith Line in Mirqab, Kuwait for construction, civil, K-Span, HVAC, telecom, IT, structured cabling, trading, supply and manpower enquiries." image="/images/completed-flooring.webp">
  <PageHero eyebrow="CONTACT ZENITH LINE" title="Start Your Project Conversation" text="Share the discipline, Kuwait area and a short requirement. For technical enquiries, drawings or bills of quantity can also be sent by email after the initial conversation." image="/images/completed-flooring.webp" imageAlt="Completed commercial flooring project in Kuwait" crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
  <section class="section section-ivory" id="enquiry"><div class="container enquiry-layout"><div class="reveal"><span class="eyebrow">KUWAIT OFFICE</span><h2>Contact Details</h2><p style="margin-top:20px">Call for direct assistance, or send a WhatsApp message for project enquiries.</p><div class="contact-details"><div class="contact-detail"><small>Call</small><a href={contact.call.href} aria-label={`Call Zenith Line on ${contact.call.display}`}>{contact.call.display}</a></div><div class="contact-detail"><small>WhatsApp enquiries</small><a href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer" aria-label={`Enquire with Zenith Line on WhatsApp at ${contact.whatsapp.display}`} data-cta-location="contact-details" data-conversion="whatsapp">{contact.whatsapp.display}</a></div><div class="contact-detail"><small>Email</small><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-detail"><small>Office address</small><span>{site.address}</span></div><div class="contact-detail"><small>Website</small><a href={site.domain}>{site.domain.replace('https://', '')}</a></div><div class="contact-detail"><small>Instagram</small><a class="contact-instagram" href={site.socials.instagram.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${site.socials.instagram.label}`} data-social="instagram" data-social-location="contact"><InstagramIcon /> <span>{site.socials.instagram.handle}</span></a><span class="contact-detail-note">Follow {site.socials.instagram.handle} for company and project updates.</span></div></div></div><div class="reveal"><EnquiryForm sourceUrl={`${site.domain}/contact/`} /></div></div></section>
  <section class="section"><div class="container content-grid"><article class="content-card reveal"><h2 style="font-size:1.8rem">What to Include</h2><ul><li>Required service or product</li><li>Kuwait area and property type</li><li>Approximate quantity or project size</li><li>Target programme or delivery date</li><li>Available drawing, BOQ or photograph</li></ul></article><article class="content-card reveal"><h2 style="font-size:1.8rem">What Happens Next</h2><ul><li>The enquiry is directed to the relevant division</li><li>The team clarifies the requirement</li><li>A survey may be scheduled where necessary</li><li>The agreed proposal or quotation is prepared</li></ul></article></div></section>
</BaseLayout>
