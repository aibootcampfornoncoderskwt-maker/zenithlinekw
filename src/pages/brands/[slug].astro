---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { publishedBrandPages, getBrandPage, type BrandPage } from '../../data/brand-pages';
import { brands, getBrandBySlug } from '../../data/brands';
import { services } from '../../data/services';
import { site, contact } from '../../data/site';

export const getStaticPaths = (() =>
  publishedBrandPages.map((brandPage) => ({ params: { slug: brandPage.slug }, props: { brandPage } }))) satisfies GetStaticPaths;

interface Props { brandPage: BrandPage }
const { brandPage } = Astro.props;
const brand = getBrandBySlug(brandPage.slug);
if (!brand) throw new Error(`Brand catalog entry missing for published brand page slug "${brandPage.slug}"`);

const canonical = `${site.domain}/brands/${brand.slug}/`;

function buildBrandWhatsappMessage(brandName: string, sourceUrl: string) {
  return [
    `Hello Zenith Line, I would like to enquire about ${brandName} products or solutions in Kuwait.`,
    '',
    'Name:',
    'Company:',
    'Mobile:',
    'Kuwait area:',
    'Product category:',
    'Model number, if known:',
    'Quantity:',
    'Installation/configuration required:',
    'Project requirement:',
    `Source page: ${sourceUrl}`
  ].join('\n');
}

const whatsappUrl = `${contact.whatsapp.href}?text=${encodeURIComponent(buildBrandWhatsappMessage(brand.name, canonical))}`;

const connectedServices = brandPage.connectedServiceSlugs
  .map((slug) => services.find((service) => service.slug === slug))
  .filter((service): service is (typeof services)[number] => Boolean(service));

const relatedBrands = brandPage.relatedBrandSlugs
  .map((slug) => {
    const relatedBrand = getBrandBySlug(slug);
    if (!relatedBrand) return null;
    const relatedPage = getBrandPage(slug);
    const href = relatedPage?.status === 'published' ? `/brands/${relatedBrand.slug}/` : '/brands/';
    return { brand: relatedBrand, href };
  })
  .filter((item): item is { brand: (typeof brands)[number]; href: string } => Boolean(item));

const brandSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: brandPage.heroTitle,
    description: brandPage.metaDescription,
    inLanguage: 'en',
    about: {
      '@type': 'Brand',
      name: brand.name,
      ...(brandPage.officialUrl ? { sameAs: brandPage.officialUrl } : {})
    },
    publisher: { '@id': `${site.domain}/#organization` }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Brands', item: `${site.domain}/brands/` },
      { '@type': 'ListItem', position: 3, name: brand.name, item: canonical }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: brandPage.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } }))
  }
];
---

<BaseLayout title={`${brandPage.seoTitle} | Zenith Line`} description={brandPage.metaDescription} image="/images/network-rack.webp" schema={brandSchema}>
  <PageHero
    eyebrow={brandPage.heroEyebrow}
    title={brandPage.heroTitle}
    text={brandPage.heroSummary}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Brands', href: '/brands/' }, { label: brand.name }]}
    primaryAction={{ label: `Enquire About ${brand.name} Products`, href: whatsappUrl, ariaLabel: `Enquire about ${brand.name} products with Zenith Line on WhatsApp` }}
    secondaryAction={{ label: 'Explore Products & Applications', href: '#product-categories' }}
    reassurance={brandPage.reassurance}
    brandName={brand.name}
    logo={brand.logo}
    logoAlt={`${brand.name} logo`}
  />

  <section class="section" aria-labelledby="glance-heading">
    <div class="container">
      <div class="section-head reveal"><div><span class="eyebrow">{brand.name.toUpperCase()} AT A GLANCE</span><h2 id="glance-heading">A direct answer for Kuwait buyers</h2></div></div>
      <p class="service-lead reveal">{brandPage.directAnswer}</p>
      <ul class="keyword-context reveal" aria-label={`${brand.name} related topics`}>{brandPage.secondaryKeywords.map((keyword) => <li>{keyword}</li>)}</ul>
    </div>
  </section>

  <section class="service-glance" aria-labelledby="dl-heading">
    <div class="container">
      <span class="sr-only" id="dl-heading">{brand.name} quick facts</span>
      <dl>
        <div><dt>Brand</dt><dd>{brand.name}</dd></div>
        <div><dt>Primary focus</dt><dd>{brandPage.primaryKeyword}</dd></div>
        <div><dt>Kuwait service area</dt><dd>Kuwait — nationwide project coordination</dd></div>
        <div><dt>Zenith Line's role</dt><dd>{brandPage.roleSummary}</dd></div>
        <div><dt>Enquiry method</dt><dd>Brand-specific WhatsApp message</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section-ivory" id="product-categories" aria-labelledby="categories-heading">
    <div class="container">
      <div class="section-head reveal"><div><span class="eyebrow">PRODUCT CATEGORIES</span><h2 id="categories-heading">{brand.name} categories commonly considered</h2></div><p>Enquiries may include the categories below, subject to specification and availability. Individual model numbers are only confirmed once verified with the manufacturer or distribution channel.</p></div>
      <div class="application-grid">{brandPage.productCategories.map((item) => <article class="application-card reveal"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      <div class="factor-cta reveal"><p><strong>Know the category or model you need?</strong> Send it through WhatsApp with quantity and application for review.</p><a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={`Enquire about ${brand.name} products on WhatsApp`} data-cta-location="after-categories" data-brand={brand.name} data-conversion="whatsapp">Enquire About {brand.name} Products <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="applications-heading">
    <div class="container">
      <div class="section-head centered reveal"><span class="eyebrow">KUWAIT PROJECT APPLICATIONS</span><h2 id="applications-heading">Where {brand.name} may be used</h2></div>
      <div class="considerations-grid">{brandPage.projectApplications.map((item) => <article class="consideration-card reveal"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section section-ivory" aria-labelledby="connected-heading">
    <div class="container">
      <div class="section-head reveal"><div><span class="eyebrow">CONNECTED CAPABILITIES</span><h2 id="connected-heading">Zenith Line services linked to {brand.name}</h2></div><p>{brand.name} enquiries are usually connected to one or more of the following existing Zenith Line service areas.</p></div>
      <ul class="keyword-context keyword-links reveal" aria-label={`Zenith Line services related to ${brand.name}`}>
        {connectedServices.map((service) => <li><a href={`/services/${service.slug}/`}>{service.shortTitle}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="factors-heading">
    <div class="container">
      <div class="section-head reveal"><div><span class="eyebrow">SELECTION &amp; QUOTATION CONSIDERATIONS</span><h2 id="factors-heading">What to consider before requesting {brand.name} pricing</h2></div><p>Transparent inputs help Zenith Line distinguish confirmed requirements from assumptions and propose the appropriate next step.</p></div>
      <div class="deliverables-grid">{brandPage.selectionFactors.map((item) => <article class="deliverable-card reveal"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      <div class="section-cta reveal"><p><strong>Send these details through WhatsApp.</strong> Your message already names {brand.name}, so the conversation starts with useful context.</p><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={`Enquire about ${brand.name} with project factors on WhatsApp`} data-cta-location="after-factors" data-brand={brand.name} data-conversion="whatsapp">Enquire About {brand.name} Products <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="section section-ivory" aria-labelledby="checklist-heading">
    <div class="container">
      <div class="section-head reveal"><div><span class="eyebrow">WHAT TO SEND FOR AN ENQUIRY</span><h2 id="checklist-heading">A scannable checklist for a useful {brand.name} enquiry</h2></div><p>Sharing these details, where known, helps the requirement move to review faster. A quotation timeframe is confirmed separately and is not promised on this page.</p></div>
      <div class="scope-grid">{brandPage.enquiryRequirements.map((item) => <div class="scope-item">{item}</div>)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container"><div class="section-head centered reveal"><span class="eyebrow">COMMON QUESTIONS</span><h2 id="faq-heading">Questions before you request a {brand.name} quotation</h2></div><div class="faq-list reveal">{brandPage.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div>
  </section>

  {relatedBrands.length > 0 && <section class="section section-ivory" aria-labelledby="related-brands-heading">
    <div class="container"><div class="section-head reveal"><div><span class="eyebrow">RELATED BRANDS</span><h2 id="related-brands-heading">Brands often reviewed alongside {brand.name}</h2></div><a class="text-link" href="/brands/">Explore the complete brand directory <span aria-hidden="true">→</span></a></div>
      <div class="related-brands-grid">{relatedBrands.map(({ brand: relatedBrand, href }) => <BrandLogo brand={relatedBrand} href={href} ariaLabel={href === '/brands/' ? `View ${relatedBrand.name} in the brand directory` : `View ${relatedBrand.name} products and solutions`} />)}</div>
    </div>
  </section>}

  <section class="section" id="brand-enquiry" aria-labelledby="enquiry-heading">
    <div class="container enquiry-layout">
      <div class="reveal">
        <span class="eyebrow">WHATSAPP ENQUIRY</span>
        <h2 id="enquiry-heading">Enquire About {brand.name} Products</h2>
        <p class="service-lead">Share the product category, model if known, quantity and project requirement, and the enquiry will be reviewed for sourcing and availability.</p>
        <p>Your enquiry will open in WhatsApp for you to review and send. The website does not claim the enquiry was submitted until you send it in WhatsApp.</p>
        <a class="button button-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={`Enquire about ${brand.name} products directly on WhatsApp`} data-cta-location="final-enquiry" data-brand={brand.name} data-conversion="whatsapp">Enquire About {brand.name} Products <span aria-hidden="true">↗</span></a>
        <div class="contact-detail"><small>Zenith Line Co.</small><span>{site.address}</span><a href={contact.call.href} aria-label={`Call Zenith Line on ${contact.call.display}`}>{contact.call.display}</a></div>
      </div>
      <div class="reveal"><EnquiryForm contextType="brand" contextValue={brand.name} compact /></div>
    </div>
  </section>

  <section class="brand-trademark-disclaimer" aria-label="Trademark disclaimer">
    <div class="container">
      <p>All trademarks, logos and brand names belong to their respective owners. References indicate products that may be sourced, supplied or integrated according to project requirements and do not imply an authorized partnership unless expressly confirmed.</p>
    </div>
  </section>
</BaseLayout>
