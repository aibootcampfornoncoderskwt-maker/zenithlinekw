---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import {
  companyLinks,
  telecomHubLink,
  constructionServices,
  telecomServices,
  tradingServices,
  brandDirectoryLinks,
  sitemapStats
} from '../data/sitemap';

const currentPath = Astro.url.pathname;

type DirectoryLink = { label: string; href: string };

const toAbsolute = (href: string) => new URL(href, site.domain).toString();

const structuredDataLinks: DirectoryLink[] = [
  ...companyLinks,
  telecomHubLink,
  ...constructionServices.map((service) => ({ label: service.shortTitle, href: `/services/${service.slug}/` })),
  ...telecomServices.map((service) => ({ label: service.shortTitle, href: `/services/${service.slug}/` })),
  ...tradingServices.map((service) => ({ label: service.shortTitle, href: `/services/${service.slug}/` })),
  ...brandDirectoryLinks
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${site.domain}/sitemap-visual/#webpage`,
    url: `${site.domain}/sitemap-visual/`,
    name: 'Website Sitemap | Zenith Line',
    description: 'A structured directory of every indexable Zenith Line company, service, ELV, general trading and brand page.',
    inLanguage: 'en',
    publisher: { '@id': `${site.domain}/#organization` }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${site.domain}/sitemap-visual/#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Website Sitemap', item: `${site.domain}/sitemap-visual/` }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${site.domain}/sitemap-visual/#directory`,
    name: 'Zenith Line indexable page directory',
    numberOfItems: structuredDataLinks.length,
    itemListElement: structuredDataLinks.map((link, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: toAbsolute(link.href)
    }))
  }
];
---

<BaseLayout
  title="Website Sitemap"
  description="A structured directory of every indexable Zenith Line company, service, Telecom & ELV, general trading and brand page, plus the XML sitemap used by search engines."
  schema={schema}
>
  <PageHero
    eyebrow="SITE DIRECTORY"
    title="Website Sitemap"
    text="Explore Zenith Line's company, service, ELV, general trading and brand pages through one structured directory."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Sitemap' }]}
  />

  <section class="section" aria-labelledby="directory-summary-heading">
    <div class="container">
      <span class="sr-only" id="directory-summary-heading">Search-readiness summary</span>
      <p class="sitemap-trust reveal">All links below represent live, indexable pages included in the website's search architecture.</p>
      <div class="sitemap-actions reveal">
        <a class="button" href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer">View XML Sitemap <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/services/">Explore All Services</a>
      </div>

      <div class="sitemap-stats reveal" style="margin-top:40px">
        <div class="sitemap-stat"><strong>{sitemapStats.total}</strong><span>Indexable pages</span></div>
        <div class="sitemap-stat"><strong>{sitemapStats.services}</strong><span>Service pages</span></div>
        <div class="sitemap-stat"><strong>{sitemapStats.brands}</strong><span>Published brand pages</span></div>
        <div class="sitemap-stat"><strong>{sitemapStats.coreCompany}</strong><span>Core company pages</span></div>
      </div>
    </div>
  </section>

  <section class="section section-ivory" aria-labelledby="directory-heading">
    <div class="container">
      <span class="sr-only" id="directory-heading">Site directory by category</span>

      <div class="sitemap-directory">
        <article class="sitemap-card reveal">
          <div class="sitemap-card-head">
            <h2>Company</h2>
            <span class="sitemap-card-count">{companyLinks.length} pages</span>
          </div>
          <ul class="sitemap-links">
            {companyLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                  <span>{link.label}</span>
                  <span class="sitemap-link-url">{toAbsolute(link.href)}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>

        <article class="sitemap-card reveal">
          <div class="sitemap-card-head">
            <h2>Construction &amp; Structures</h2>
            <span class="sitemap-card-count">{constructionServices.length} pages</span>
          </div>
          <ul class="sitemap-links">
            {constructionServices.map((service) => (
              <li><a href={`/services/${service.slug}/`}><span>{service.shortTitle}</span><span class="sitemap-link-url">{toAbsolute(`/services/${service.slug}/`)}</span></a></li>
            ))}
          </ul>
        </article>

        <article class="sitemap-card sitemap-card-telecom reveal">
          <div class="sitemap-card-head">
            <h2><a href={telecomHubLink.href}>Telecom, IT &amp; ELV</a></h2>
            <span class="sitemap-card-count">{telecomServices.length + 1} pages</span>
          </div>
          <ul class="sitemap-links">
            <li><a href={telecomHubLink.href}><span>{telecomHubLink.label}</span><span class="sitemap-link-url">{toAbsolute(telecomHubLink.href)}</span></a></li>
            {telecomServices.map((service) => (
              <li><a href={`/services/${service.slug}/`}><span>{service.shortTitle}</span><span class="sitemap-link-url">{toAbsolute(`/services/${service.slug}/`)}</span></a></li>
            ))}
          </ul>
        </article>

        <article class="sitemap-card reveal">
          <div class="sitemap-card-head">
            <h2>General Trading &amp; Manpower</h2>
            <span class="sitemap-card-count">{tradingServices.length} pages</span>
          </div>
          <ul class="sitemap-links">
            {tradingServices.map((service) => (
              <li><a href={`/services/${service.slug}/`}><span>{service.shortTitle}</span><span class="sitemap-link-url">{toAbsolute(`/services/${service.slug}/`)}</span></a></li>
            ))}
          </ul>
        </article>
      </div>

      <article class="sitemap-card sitemap-brands reveal">
        <div class="sitemap-card-head">
          <div>
            <h2>Published Brand Pages</h2>
            <p>Every brand listed below has its own indexable Zenith Line page.</p>
          </div>
          <span class="sitemap-card-count">{brandDirectoryLinks.length} pages</span>
        </div>
        <ul class="sitemap-links">
          {brandDirectoryLinks.map((link) => (
            <li><a href={link.href}><span>{link.label}</span><span class="sitemap-link-url">{toAbsolute(link.href)}</span></a></li>
          ))}
        </ul>
        <div class="sitemap-brands-footnote">
          <p>Additional brands referenced in the company profile are represented through the brand directory rather than individual pages.</p>
          <a class="text-link" href="/brands/">View all available brands <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <p class="sitemap-note reveal">This directory reflects the website's current indexable page structure. Search-engine discovery and indexing remain subject to each platform's crawling and quality systems.</p>
    </div>
  </section>
</BaseLayout>
