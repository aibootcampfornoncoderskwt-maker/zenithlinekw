---
import type { Service } from '../data/services';
import { site } from '../data/site';

interface Props { service: Service; index?: number }
const { service, index = 0 } = Astro.props;
const canonical = `${site.domain}/services/${service.slug}/`;
const preparedMessage = `${service.whatsapp.replace(/\nSource page:\s*$/, '')}\nSource page: ${canonical}`;
const whatsappUrl = `https://wa.me/${site.phoneRaw}?text=${encodeURIComponent(preparedMessage)}`;
---

<article class="service-card reveal" style={`--delay:${Math.min(index % 4, 3) * 70}ms`}>
  <a class="service-image" href={`/services/${service.slug}/`} aria-label={`Read about ${service.shortTitle}`}>
    <img src={service.image} alt={service.imageAlt} width={service.imageWidth} height={service.imageHeight} loading="lazy" decoding="async" />
    <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
  </a>
  <div class="service-card-body">
    <small>{service.category}</small>
    <h3><a href={`/services/${service.slug}/`}>{service.shortTitle}</a></h3>
    <p>{service.summary}</p>
    <div class="service-actions">
      <a class="text-link" href={`/services/${service.slug}/`}>View service <span>→</span></a>
      <a class="service-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={`Ask Zenith Line about ${service.shortTitle} on WhatsApp`} data-cta-location="related-service" data-service={service.shortTitle} data-conversion="whatsapp"><span></span> Ask about this service</a>
    </div>
  </div>
</article>
