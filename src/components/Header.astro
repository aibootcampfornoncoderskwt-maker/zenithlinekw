---
import { site, contact } from '../data/site';
import InstagramIcon from './InstagramIcon.astro';
import PhoneIcon from './PhoneIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const path = Astro.url.pathname;
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const whatsappUrl = `${contact.whatsapp.href}?text=${encodeURIComponent('Hello Zenith Line, I would like to discuss a project requirement in Kuwait.')}`;
---

<div class="utility-bar">
  <div class="container utility-inner">
    <span class="utility-kicker"><b>KUWAIT</b> Multi-disciplinary contracting, technology & supply</span>
    <div class="utility-links">
      <div class="utility-contact">
        <a class="utility-icon-link" href={contact.call.href} aria-label={`Call Zenith Line at ${contact.call.display}`}>
          <PhoneIcon />
        </a>
        <a class="utility-icon-link" data-utility-contact="whatsapp" href={`https://wa.me/${contact.call.raw}`} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp Zenith Line at ${contact.call.display}`}>
          <WhatsAppIcon />
        </a>
        <a class="utility-phone-number" href={contact.call.href}>{contact.call.display}</a>
      </div>
      <a href={`mailto:${site.email}`}><span>Email</span> {site.email}</a>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Zenith Line home">
      <span class="brand-mark"><img src="/images/zenith-logo.png" alt="" width="48" height="48" /></span>
      <span class="brand-copy"><strong>ZENITH LINE <i>CO.</i></strong><small>CONTRACTING · TECHNOLOGY · SUPPLY</small></span>
    </a>

    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-navigation" data-menu-toggle>
      <span></span><span></span><span></span><span class="sr-only" data-menu-label>Open navigation</span>
    </button>

    <nav class="main-nav" id="main-navigation" aria-label="Main navigation" data-menu>
      <div class="mobile-menu-head">
        <strong>Explore Zenith Line</strong>
        <span>Kuwait project solutions</span>
      </div>
      <a class:list={[active('/') && 'is-active']} href="/">Home</a>
      <div class="nav-dropdown">
        <button class:list={['desktop-services-toggle', active('/services/') && 'is-active']} type="button" aria-expanded="false" aria-controls="services-mega-menu" data-desktop-dropdown-toggle>
          Services <span class="chevron" aria-hidden="true"></span>
        </button>
        <div class="dropdown-panel desktop-mega-menu" id="services-mega-menu">
          <a class="mega-overview" href="/services/">
            <small>ALL CAPABILITIES</small>
            <strong>One accountable partner across every project discipline.</strong>
            <span>Explore all 20 services <b>→</b></span>
          </a>
          <div class="mega-group">
            <strong>Construction & Structures</strong>
            <a href="/services/construction-renovation/">Construction & Renovation</a>
            <a href="/services/civil-road-works/">Civil & Road Works</a>
            <a href="/services/k-span-structures/">K-Span Structures</a>
            <a href="/services/shade-structures/">Shade Structures</a>
            <a href="/services/hvac-services/">HVAC Services</a>
            <a href="/services/specialized-civil-services/">Specialized Civil Services</a>
          </div>
          <div class="mega-group mega-group-telecom">
            <strong><a href="/services/telecom-it/">Telecom & IT</a></strong>
            <a href="/services/wired-network/">Wired Network</a>
            <a href="/services/wireless-microwave-networks/">Wireless & Microwave</a>
            <a href="/services/structured-cabling/">Structured Cabling</a>
            <a href="/services/cctv-surveillance-systems/">CCTV Surveillance</a>
            <a href="/services/pbx-telephone-exchange/">PBX & IP Telephone</a>
            <a href="/services/door-access-security/">Door Access & Security</a>
            <a href="/services/public-address-systems/">Public Address Systems</a>
            <a href="/services/router-wifi/">Wi-Fi, Router & AP</a>
            <a href="/services/network-security/">Network Security</a>
            <a href="/services/installation-support/">IT Services & Support</a>
          </div>
          <div class="mega-group">
            <strong>General Trading & Manpower</strong>
            <a href="/services/import-export/">Import / Export</a>
            <a href="/services/supply-logistics/">Supply & Logistics</a>
            <a href="/services/engineering-manpower/">Engineering & Manpower</a>
            <a href="/services/tools-equipment-rental/">Tools & Equipment</a>
            <a class="view-all-link" href="/company-profile/">Company profile <span>↗</span></a>
          </div>
        </div>
        <button class:list={['mobile-services-toggle', active('/services/') && 'is-active']} type="button" aria-expanded="false" aria-controls="mobile-services-submenu" data-mobile-services-toggle>
          Services <span class="chevron" aria-hidden="true"></span>
        </button>
        <div class="mobile-services-panel" id="mobile-services-submenu" data-mobile-services-panel hidden>
          <a class="mobile-services-overview" href="/services/">Explore all 20 services <span aria-hidden="true">→</span></a>
          <div class="mobile-services-group">
            <strong>Construction & Structures</strong>
            <a href="/services/construction-renovation/">Construction & Renovation</a>
            <a href="/services/civil-road-works/">Civil & Road Works</a>
            <a href="/services/k-span-structures/">K-Span Structures</a>
            <a href="/services/shade-structures/">Shade Structures</a>
            <a href="/services/hvac-services/">HVAC Services</a>
            <a href="/services/specialized-civil-services/">Specialized Civil Services</a>
          </div>
          <div class="mobile-services-group">
            <strong><a href="/services/telecom-it/">Telecom & IT</a></strong>
            <a href="/services/wired-network/">Wired Network</a>
            <a href="/services/wireless-microwave-networks/">Wireless & Microwave</a>
            <a href="/services/structured-cabling/">Structured Cabling</a>
            <a href="/services/cctv-surveillance-systems/">CCTV Surveillance</a>
            <a href="/services/pbx-telephone-exchange/">PBX & IP Telephone</a>
            <a href="/services/door-access-security/">Door Access & Security</a>
            <a href="/services/public-address-systems/">Public Address Systems</a>
            <a href="/services/router-wifi/">Wi-Fi, Router & AP</a>
            <a href="/services/network-security/">Network Security</a>
            <a href="/services/installation-support/">IT Services & Support</a>
          </div>
          <div class="mobile-services-group">
            <strong>General Trading & Manpower</strong>
            <a href="/services/import-export/">Import / Export</a>
            <a href="/services/supply-logistics/">Supply & Logistics</a>
            <a href="/services/engineering-manpower/">Engineering & Manpower</a>
            <a href="/services/tools-equipment-rental/">Tools & Equipment</a>
          </div>
        </div>
      </div>
      <a class:list={[active('/products-supply/') && 'is-active']} href="/products-supply/">Products & Supply</a>
      <a class:list={[active('/brands/') && 'is-active']} href="/brands/">Brands</a>
      <a class:list={[active('/projects/') && 'is-active']} href="/projects/">Projects</a>
      <a class:list={[active('/about/') && 'is-active']} href="/about/">About</a>
      <a class:list={[active('/contact/') && 'is-active']} href="/contact/">Contact</a>
      <a class="button button-small nav-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={`Enquire with Zenith Line on WhatsApp at ${contact.whatsapp.display}`} data-cta-location="header" data-conversion="whatsapp"><span class="status-dot"></span> WhatsApp Enquiry</a>
      <a
        class="mobile-menu-social"
        href={site.socials.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visit ${site.socials.instagram.label}`}
        data-social="instagram"
        data-social-location="mobile-menu"
      >
        <InstagramIcon />
        <span>{site.socials.instagram.handle}</span>
        <span class="mobile-menu-social-external" aria-hidden="true">↗</span>
      </a>
      <div class="mobile-menu-contact">
        <span>Direct assistance</span>
        <a href={contact.call.href} aria-label={`Call Zenith Line on ${contact.call.display}`}>{contact.call.display}</a>
      </div>
    </nav>
  </div>
</header>
<button class="menu-backdrop" type="button" aria-label="Close navigation" data-menu-backdrop></button>
